# Python
__pycache__/
*.pyc
.venv/
.env
.env.*

# Data/outputs
/data/*
!data/.gitkeep
!data/team_branding.csv
!data/d1_conferences.csv
!data/team_map.csv
!data/conferences.csv
/outputs/*
!outputs/.gitkeep
# Keep only minimal UI snapshots and archives for Render parity
!outputs/predictions_display_*-*.csv
!outputs/predictions_unified_enriched_*-*.csv
!outputs/archive/*/predictions_display_*-*.csv
# Allow status and diagnostics via forced staging in the daily script; .gitignore will still ignore by default
# (daily_update.ps1 uses force-add for outputs/metrics and outputs/diagnostics)
# Everything else in outputs remains ignored to avoid noisy commits and large files

